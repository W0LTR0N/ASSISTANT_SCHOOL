# === Plusofon SIP ===
PLUSOFON_SIP_HOST=sip.plusofon.ru
PLUSOFON_SIP_PORT=5060
PLUSOFON_SIP_USER=your_sip_user
PLUSOFON_SIP_PASSWORD=your_sip_password

# LIVE-TEST REQUIRED
OUTBOUND_RURI_TEMPLATE=sip:{phone}@{host}
OUTBOUND_FROM_TEMPLATE=sip:{user}@{host}

# RTP
RTP_PORT_MIN=10000
RTP_PORT_MAX=10100

# Network
PUBLIC_IP=your_public_ip

# Security
TRUSTED_SIP_IPS=
BLACKLIST_SIP_IPS=
SIP_RATE_LIMIT_PER_IP=10

# Yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest

# GenVoice
GENVOICE_API_KEY=
GENVOICE_REALTIME_URL=wss://api.genvoice.ru/ws
GENVOICE_VOICE=filipp

# Albato
ALBATO_WEBHOOK_URL=
ALBATO_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# Database
DATABASE_PATH=/app/data/woltron.db

# VAD
SPEECH_RMS_THRESHOLD=300
SILENCE_TO_END_MS=800
MAX_UTTERANCE_MS=15000
VAD_PREROLL_MS=200

# Limits
MAX_CONCURRENT_CALLS=10
MAX_CALL_DURATION=1800
MEDIA_IDLE_TIMEOUT=60
MAX_AUDIO_BUFFER_BYTES=160000
MAX_RTP_BUFFER_BYTES=320000

# SIP Timeouts
SIP_T1=0.5
SIP_T2=4.0
SIP_TIMER_B=32.0
SIP_TIMER_F=32.0
SIP_MAX_RETRANSMITS=7

# API Timeouts
STT_TIMEOUT=10.0
GPT_TIMEOUT=15.0
TTS_TIMEOUT=30.0
DELIVERY_TIMEOUT=10.0

# Delivery Retry
DELIVERY_RETRY_INTERVAL=60
DELIVERY_MAX_RETRIES=5

# Heartbeat
HEARTBEAT_INTERVAL=30
HEARTBEAT_FILE=/app/data/heartbeat.txt

# Development
DEVELOPMENT_MODE=false
STRICT_ENV=true
